{
  "name": "deploymcp",
  "version": "0.1.0",
  "description": "Zero-SSH Docker deploys for AI coding agents (Claude Code, Cursor, Windsurf) — MCP server",
  "type": "module",
  "bin": {
    "deploymcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/test",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test dist/test/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "deploy",
    "docker",
    "claude-code",
    "cursor",
    "self-hosted"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ignore": "^7.0.17",
    "tar": "^7.5.23",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZenithHawking/deploymcp.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/ZenithHawking/deploymcp#readme"
}
